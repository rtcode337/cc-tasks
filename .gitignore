# ビルド成果物
backend/build/
backend/.gradle/
frontend/dist/
frontend/node_modules/
# Vue のビルド結果を同梱する場所 (Docker ビルド時に生成)
backend/src/main/resources/static/

# ローカルの SQLite
backend/data/
*.db
*.db-wal
*.db-shm

# Docker のデータ置き場(SQLite とセッション)。ディレクトリごと追跡しない ──
# 無い状態で up しても Docker が作り、cctasks-init が所有者を揃えるので、
# 空の置き場を配る必要がない(バックアップ先の説明は README と CLAUDE.md にある)
data/

# 秘密情報
.env
# .env を置けない環境へ貼り付ける用のコピー。実値を直接書くのでコミットしない
# (雛形は compose.standalone.example.yaml)
compose.standalone.yaml

.DS_Store
