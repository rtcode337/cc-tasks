# compose.yaml が読み込む。実ファイル (.env) はコミットしないこと
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# ログインを許可する Google アカウント (1 件のみ)
ALLOWED_EMAIL=you@example.com

# 公開 URL。OAuth は未設定でもリクエスト(X-Forwarded-Proto/Host)から
# 自動導出するので任意。プロキシがそれらを送らない場合のみ設定する。
#PUBLIC_BASE_URL=https://cctasks.example.com

# PUBLIC_BASE_URL を設定せず、Host/X-Forwarded-Host からリダイレクト URI を
# 自動導出させる場合に**必須**。ここに載せたホストでしか書き換えない
# (ヘッダは攻撃者が自由に付けられるため)。ポート込み・カンマ区切り。
# 未設定だと自動導出は行われず、Spring 既定の {baseUrl} 展開になる
#ALLOWED_REDIRECT_HOSTS=cctasks.example.com:8443,cctasks.example.com

# 表示・ログのタイムゾーン。未設定なら Asia/Tokyo
#TZ=Asia/Tokyo

# data/ に書き込むときのユーザー。未設定なら 1000:1000。
# `id -u` / `id -g` が 1000 以外のホストでは合わせて設定する
#CCTASKS_UID=1000
#CCTASKS_GID=1000
