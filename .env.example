# compose.yaml が読み込む。実ファイル (.env) はコミットしないこと
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# ログインを許可する Google アカウント (1 件のみ)
ALLOWED_EMAIL=you@example.com

# 公開 URL。OAuth は未設定でもリクエスト(X-Forwarded-Proto/Host)から
# 自動導出するので任意。プロキシがそれらを送らない場合のみ設定する。
#PUBLIC_BASE_URL=https://cctasks.example.com

# 表示・ログのタイムゾーン。未設定なら Asia/Tokyo
#TZ=Asia/Tokyo
